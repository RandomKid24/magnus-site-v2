# Public URL of the website (canonical links, sitemap, etc.)
APP_URL="http://localhost:3000"

# ---------------------------------------------------------------------------
# Supabase (https://supabase.com/dashboard -> Project Settings -> API)
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. NEVER expose this to the browser or commit real values.
SUPABASE_SERVICE_ROLE_KEY=

# ---------------------------------------------------------------------------
# First administrator bootstrap (`npm run create-admin`)
# ---------------------------------------------------------------------------
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_FULL_NAME=

# ---------------------------------------------------------------------------
# Cloudinary (https://console.cloudinary.com -> Settings -> API Keys)
# ---------------------------------------------------------------------------
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
